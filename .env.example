# Copy this file to .env and replace the placeholder values.
# Never commit .env: it is ignored by git.

# HTTP port the API listens on.
PORT=3000

# PostgreSQL connection string (required).
DATABASE_URL=postgres://protactics:change-me@localhost:5432/protactics

# TLS for the database connection:
#   false     -> no TLS (default, local development)
#   true      -> TLS with certificate verification
#   no-verify -> TLS without verifying the certificate (some managed hosts)
DATABASE_SSL=false

# Secret used to sign JWTs (required). Use a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Token lifetime, in the format accepted by jsonwebtoken (e.g. 24h, 7d).
JWT_EXPIRES_IN=24h

# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Set to 1 when the API runs behind one reverse proxy (Render, Railway, Heroku...)
# so rate limiting sees the real client IP. Leave empty when exposed directly.
TRUST_PROXY=
